        "print(f\"Training {N_ENS}-member {BEST} ensemble\")\n",
        "ens = [models[BEST]] + [train(BEST, FI, seed=s)[0] for s in range(1, N_ENS)]\n",
        "Rte_m = np.stack([resid(m, Xte_s, FI) for m in ens])        # (members, N, 16)\n",
        "Rva_m = np.stack([resid(m, Xva_s, FI) for m in ens])\n",
        "ENS = f\"Ensemble ({N_ENS} x {BEST})\"\n",
        "preds[ENS] = Pp_te + Rte_m.mean(0); results[ENS] = eval_preds(preds[ENS], Yte, mte)\n",
        "\n",
        "res = pd.DataFrame(results).T.round(1); display(res); res.to_csv(OUT / \"results_comparison.csv\")\n",
        "for n in [\"Ridge\", \"MLP\", \"LSTM\", \"GRU\", ENS]:\n",
        "    g1 = (results[\"Persistence\"][\"track_km_24h\"] - results[n][\"track_km_24h\"]) / results[\"Persistence\"][\"track_km_24h\"] * 100\n",
        "    g2 = (results[\"Persistence\"][\"wind_mae_24h\"] - results[n][\"wind_mae_24h\"]) / results[\"Persistence\"][\"wind_mae_24h\"] * 100\n",
        "    print(f\"{n:24s} improvement over persistence at 24 h: track {g1:+5.1f}%, wind {g2:+5.1f}%  (positive = better)\")\n",
        "\n",
        "leads = [6 * (k + 1) for k in range(STEPS)]\n",
        "fig, ax = plt.subplots(1, 2, figsize=(12, 4))\n",
        "for n in results:\n",
        "    ax[0].plot(leads, [results[n][f\"track_km_{l}h\"] for l in leads], \"o-\", label=n, lw=3 if n == ENS else 1.5)\n",
        "    ax[1].plot(leads, [results[n][f\"wind_mae_{l}h\"] for l in leads], \"o-\", label=n, lw=3 if n == ENS else 1.5)\n",
        "ax[0].set_title(\"Track error (km), lower is better\"); ax[1].set_title(\"Wind error (kt), lower is better\")\n",
        "for a in ax: a.set_xlabel(\"lead time (h)\"); a.set_xticks(leads); a.legend(fontsize=7); a.grid(alpha=.3)\n",
        "plt.tight_layout(); plt.savefig(OUT / \"fig_error_vs_lead.png\", dpi=150); plt.show()"
      ]
    },
