    {
      "cell_type": "code",
      "execution_count": 27,
      "id": "e0f3b2eb",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "e0f3b2eb",
        "outputId": "c38ea520-feb2-47ee-a41d-1e5d0dd0177c"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "File size (MB): 145.2\n",
            "Years in file: 1980 to 2026\n",
            "4677 storms, 138122 six-hourly observations, 1980 to 2026; pressure available for 85%\n"
          ]
        }
      ],
      "source": [
        "DATA_CSV = None\n",
        "URL = (\"https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/\"\n",
        "       \"v04r01/access/csv/ibtracs.since1980.list.v04r01.csv\")\n",
        "if DATA_CSV is None:\n",
        "    DATA_CSV = \"/content/ibtracs.since1980.list.v04r01.csv\"\n",
        "    if not os.path.exists(DATA_CSV): urllib.request.urlretrieve(URL, DATA_CSV)\n",
        "print(\"File size (MB):\", round(os.path.getsize(DATA_CSV) / 1e6, 1))\n",
        "if os.path.getsize(DATA_CSV) < 50e6:\n",
        "    print(\"WARNING: this file is much smaller than the full since1980 CSV (expected well over 100 MB). You may have the wrong file (e.g. last3years or ACTIVE), which holds only recent storms.\")\n",
        "\n",
        "hdr = pd.read_csv(DATA_CSV, nrows=0).columns.tolist()\n",
        "TT = \"TRACK_TYPE\" if \"TRACK_TYPE\" in hdr else \"TRK_TYPE\"        # CSV files use TRACK_TYPE (shapefiles use TRK_TYPE)\n",
        "cols = [\"SID\", \"SEASON\", \"BASIN\", \"NAME\", \"ISO_TIME\", \"LAT\", \"LON\", \"WMO_WIND\", \"USA_WIND\", \"WMO_PRES\", \"USA_PRES\", \"DIST2LAND\", TT]\n",
        "missing = [c for c in cols if c not in hdr]\n",
        "assert not missing, f\"Columns not found in the CSV: {missing}. Columns present: {hdr[:40]}\"\n",
        "raw = pd.read_csv(DATA_CSV, skiprows=[1], usecols=cols, low_memory=False, keep_default_na=False, na_values=[\" \", \"\"])   # row 2 holds units; keep_default_na=False so basin code \"NA\" (North Atlantic) is not read as missing\n",
        "for c in [\"SEASON\", \"LAT\", \"LON\", \"WMO_WIND\", \"USA_WIND\", \"WMO_PRES\", \"USA_PRES\", \"DIST2LAND\"]:\n",
        "    raw[c] = pd.to_numeric(raw[c], errors=\"coerce\")\n",
        "raw = raw.rename(columns={TT: \"TRK_TYPE\"})\n",
        "raw[\"time\"] = pd.to_datetime(raw.ISO_TIME, errors=\"coerce\")\n",
        "print(\"Years in file:\", int(raw.time.dt.year.min()), \"to\", int(raw.time.dt.year.max()))\n",
        "df = raw[(raw.TRK_TYPE == \"main\") & raw.time.notna() & (raw.time.dt.hour % 6 == 0) & (raw.time.dt.minute == 0)].copy()\n",
        "df[\"wind\"] = df.WMO_WIND.fillna(df.USA_WIND)          # knots; JTWC/NHC value where the WMO agency gives none\n",
        "df[\"pres\"] = df.WMO_PRES.fillna(df.USA_PRES)          # hPa, often missing\n",
        "df = (df.dropna(subset=[\"LAT\", \"LON\", \"wind\", \"DIST2LAND\"]).sort_values([\"SID\", \"time\"])\n",
        "        .drop_duplicates([\"SID\", \"time\"]).reset_index(drop=True))\n",
        "assert len(df) > 5000, \"Too few rows after cleaning - check the CSV.\"\n",
        "print(f\"{df.SID.nunique()} storms, {len(df)} six-hourly observations, {df.time.min():%Y} to {df.time.max():%Y}; pressure available for {df.pres.notna().mean():.0%}\")"
      ]
