        "sets = {\"Base: position, wind, geography, season\": GROUPS[\"base\"],\n",
        "        \"+ motion and pressure\": GROUPS[\"base\"] + GROUPS[\"motion_pressure\"]}\n",
        "if use_env: sets[\"+ environment (SST, shear, steering)\"] = GROUPS[\"base\"] + GROUPS[\"motion_pressure\"] + GROUPS[\"environment\"]\n",
        "abl = {}\n",
        "for name, fi in sets.items():\n",
        "    m_, _ = train(\"GRU\", fi, seed=0); abl[name] = eval_preds(Pp_te + resid(m_, Xte_s, fi), Yte, mte)\n",
        "abl_df = pd.DataFrame(abl).T[[\"track_km_12h\", \"track_km_24h\", \"wind_mae_12h\", \"wind_mae_24h\", \"d2l_mae_24h\"]].round(1)\n",
        "display(abl_df); abl_df.to_csv(OUT / \"ablation.csv\")\n",
        "\n",
        "rng = np.random.default_rng(SEED); importance = {}\n",
        "base_r = eval_preds(preds[ENS], Yte, mte)\n",
        "for g, gi in GROUPS.items():\n",
        "    if not all(i in FI for i in gi): continue\n",
        "    Xp = Xte_s.copy(); Xp[:, :, gi] = Xte_s[rng.permutation(len(Xp))][:, :, gi]\n",
        "    P = Pp_te + np.mean([resid(m, Xp, FI) for m in ens], axis=0); r = eval_preds(P, Yte, mte)\n",
        "    importance[GROUP_LABELS[g]] = dict(track=r[\"track_km_24h\"] - base_r[\"track_km_24h\"], wind=r[\"wind_mae_24h\"] - base_r[\"wind_mae_24h\"])\n",
        "imp = pd.DataFrame(importance).T.round(2); display(imp)\n",
        "imp[\"track\"].plot.barh(figsize=(7, 3), color=\"#1565C0\"); plt.xlabel(\"24 h track error increase when shuffled (km)\")\n",
        "plt.tight_layout(); plt.savefig(OUT / \"fig_importance.png\", dpi=150); plt.show()"
      ]
    },
