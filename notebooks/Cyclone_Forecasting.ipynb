        "## 6. Evaluation helpers and baselines\n",
        "**Track error** = great-circle distance (km); **intensity error** = mean absolute wind error (kt); **land-distance error** in km. **Persistence** = constant motion, constant wind, constant distance to land."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "id": "b40cd8d6",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "b40cd8d6",
        "outputId": "c3f5740b-aaeb-434d-8499-6dc7b2c347d5"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "             track_km_24h  wind_mae_24h\n",
            "Persistence         189.4          12.3\n",
            "Ridge               167.7          10.4\n"
          ]
        }
      ],
      "source": [
        "def eval_preds(P, Yt, m):\n",
        "    out = {}; lat0, lon0 = m.lat0.values, m.lon0.values\n",
        "    for k in range(STEPS):\n",
        "        out[f\"track_km_{6 * (k + 1)}h\"] = float(haversine_km(lat0 + P[:, k], lon0 + P[:, STEPS + k], lat0 + Yt[:, k], lon0 + Yt[:, STEPS + k]).mean())\n",
        "    for k in range(STEPS):\n",
        "        out[f\"wind_mae_{6 * (k + 1)}h\"] = float(np.abs(P[:, 2 * STEPS + k] - Yt[:, 2 * STEPS + k]).mean())\n",
        "    out[\"d2l_mae_24h\"] = float(np.abs(P[:, 4 * STEPS - 1] - Yt[:, 4 * STEPS - 1]).mean())\n",
        "    return out\n",
        "\n",
        "def mean_track_24(P, Yt, m): return eval_preds(P, Yt, m)[\"track_km_24h\"]\n",
        "results, preds = {}, {}\n",
        "preds[\"Persistence\"] = Pp_te; results[\"Persistence\"] = eval_preds(Pp_te, Yte, mte)\n",
        "\n",
        "ridge = Ridge(alpha=1.0).fit(Xtr_s[:, :, FI].reshape(len(Xtr_s), -1), Rtr_s)\n",
        "preds[\"Ridge\"] = Pp_te + ridge.predict(Xte_s[:, :, FI].reshape(len(Xte_s), -1)) * r_std + r_mean\n",
        "results[\"Ridge\"] = eval_preds(preds[\"Ridge\"], Yte, mte)\n",
        "print(pd.DataFrame(results).T[[\"track_km_24h\", \"wind_mae_24h\"]].round(1))"
      ]
    },
