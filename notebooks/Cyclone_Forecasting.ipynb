      "source": [
        "sc_dict = {\"x_mean\": x_mean[FI], \"x_std\": x_std[FI], \"r_mean\": r_mean, \"r_std\": r_std, \"feat_idx\": FI}\n",
        "def storm_cols(g): return dict(lat=g.LAT.values, lon=g.LON.values, wind=g.wind.values.astype(float), d2l=g.DIST2LAND.values,\n",
        "                               month=g.time.dt.month.values, pres=g.pres.values, sst=g.sst.values, shear=g.shear.values,\n",
        "                               steer_u=g.steer_u.values, steer_v=g.steer_v.values)\n",
        "def to_obs(g):\n",
        "    cl = lambda v: None if not np.isfinite(v) else float(v)\n",
        "    return [[t.strftime(\"%Y-%m-%d %H:%M\"), float(a), float(b), float(w), cl(p), float(d_), cl(s), cl(sh), cl(su), cl(sv)]\n",
        "            for t, a, b, w, p, d_, s, sh, su, sv in zip(g.time, g.LAT, g.LON, g.wind, g.pres, g.DIST2LAND, g.sst, g.shear, g.steer_u, g.steer_v)]\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12, 9)); demo = []; case_rows = []\n",
        "for ax, (nm, yr) in zip(axes.ravel(), CASES):\n",
        "    sids = df[(df.NAME == nm) & (df.SEASON == yr) & (df.BASIN == \"NI\")].SID.unique()\n",
        "    if len(sids) == 0: ax.set_title(f\"{nm}: not available\"); continue\n",
        "    g = df[df.SID == sids[0]].reset_index(drop=True); c = storm_cols(g)\n",
        "    demo.append({\"name\": f\"{nm.title()} {yr} (NI)\", \"obs\": to_obs(g)})\n",
        "    ax.plot(g.LON, g.LAT, \"-\", color=\"lightgray\", lw=5); errs = []\n",
        "    for e in range(H, len(g) - STEPS, 3):\n",
        "        fc = forecast_ensemble(ens, sc_dict, *(c[k][:e + 1] for k in [\"lat\", \"lon\", \"wind\", \"d2l\", \"month\", \"pres\", \"sst\", \"shear\", \"steer_u\", \"steer_v\"]))\n",
        "        for mi in range(N_ENS): ax.plot([g.LON[e], fc[\"members\"][\"lon\"][mi, -1]], [g.LAT[e], fc[\"members\"][\"lat\"][mi, -1]], \"-\", color=\"salmon\", lw=.6, alpha=.6)\n",
        "        ax.plot([g.LON[e], fc[\"mean\"][\"lon\"][-1]], [g.LAT[e], fc[\"mean\"][\"lat\"][-1]], \"r-\", lw=1.2)\n",
        "        errs.append(float(haversine_km(fc[\"mean\"][\"lat\"][-1], fc[\"mean\"][\"lon\"][-1], g.LAT[e + STEPS], g.LON[e + STEPS])))\n",
        "    ax.set_title(f\"{nm.title()} {yr}: mean 24 h track error {np.mean(errs):.0f} km ({len(errs)} forecasts)\", fontsize=10); ax.grid(alpha=.3)\n",
        "    case_rows.append(dict(storm=f\"{nm.title()} {yr}\", forecasts=len(errs), mean_24h_track_km=round(float(np.mean(errs)), 0)))\n",
        "plt.tight_layout(); plt.savefig(OUT / \"fig_case_studies.png\", dpi=150); plt.show()\n",
        "display(pd.DataFrame(case_rows)); pd.DataFrame(case_rows).to_csv(OUT / \"case_studies.csv\", index=False)\n",
        "\n",
        "# extra held-out storms for the app (strongest named test storms from other basins)\n",
        "named = df[df.SID.isin(te_s) & df.NAME.notna() & (df.NAME != \"NOT_NAMED\") & (~df.SID.isin(forced))]\n",
        "top = named.groupby(\"SID\").agg(peak=(\"wind\", \"max\"), n=(\"wind\", \"size\"), name=(\"NAME\", \"first\"), yr=(\"SEASON\", \"first\"), basin=(\"BASIN\", \"first\"))\n",
        "for sid, r in top[top.n >= 24].sort_values(\"peak\", ascending=False).head(8).iterrows():\n",
        "    demo.append({\"name\": f\"{str(r['name']).title()} {int(r.yr)} ({r.basin})\", \"obs\": to_obs(df[df.SID == sid].reset_index(drop=True))})\n",
        "print(\"Demo storms for the app:\", [d_[\"name\"] for d_ in demo])"
      ]
