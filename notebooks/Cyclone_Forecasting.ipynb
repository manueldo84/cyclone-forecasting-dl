      "source": [
        "## 4. Environmental fields: SST, wind shear, steering flow\n",
        "For every observation we sample (nearest grid cell, month/day of the observation):\n",
        "- **SST:** NOAA ERSSTv5 monthly, 2 degree grid.\n",
        "- **Winds:** NCEP/NCAR Reanalysis 1 daily-mean u/v at 850, 500, 200 hPa, 2.5 degree grid, **averaged over a 5x5 grid-cell box (about 12 degrees)** around the storm.\n",
        "  - *Shear* = magnitude of (wind at 200 hPa minus wind at 850 hPa). High shear tears storms apart.\n",
        "  - *Steering* = mean of the 850/500/200 hPa wind vectors, which is what carries a storm along.\n",
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 28,
      "id": "a48d2850",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "a48d2850",
        "outputId": "e3b1dd89-ee01-4989-ae4c-441511fc7568"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Loaded cached environment fields\n",
            "coverage: {'sst': 0.93, 'shear': 1.0, 'steer_u': 1.0, 'steer_v': 1.0}\n",
            "USE_ENV = True | 2589 storms, 74874 observations\n"
          ]
        }
      ],
      "source": [
        "SST_URL = \"https://psl.noaa.gov/thredds/dodsC/Datasets/noaa.ersst.v5/sst.mnmean.nc\"\n",
        "WIND_URLS = [\"https://psl.noaa.gov/thredds/dodsC/Datasets/ncep.reanalysis.dailyavgs/pressure/{var}.{year}.nc\",\n",
        "             \"https://psl.noaa.gov/thredds/dodsC/Datasets/ncep.reanalysis/pressure/{var}.{year}.nc\"]\n",
        "ENV_CACHE = \"/content/env_cache.csv\"        # tip: copy this file to Google Drive to keep it between sessions\n",
        "ENV_COLS = [\"sst\", \"shear\", \"steer_u\", \"steer_v\"]\n",
        "\n",
        "def open_retry(urls, tries=3, **fmt):\n",
        "    last = None\n",
        "    for u in urls:\n",
        "        for t in range(tries):\n",
        "            try: return xr.open_dataset(u.format(**fmt), engine=\"netcdf4\")\n",
        "            except Exception as e: last = e; time.sleep(2 * (t + 1))\n",
        "    raise RuntimeError(f\"could not open {urls[0].format(**fmt)}: {last}\")\n",
        "\n",
        "def nearest_index(coord, vals):\n",
        "    coord = np.asarray(coord, float); order = np.argsort(coord); cs = coord[order]\n",
        "    i = np.clip(np.searchsorted(cs, vals), 1, len(cs) - 1)\n",
        "    i = np.where(np.abs(vals - cs[i - 1]) <= np.abs(vals - cs[i]), i - 1, i)\n",
        "    return order[i]\n",
        "\n",
        "def box_mean(field, ti, li, lj, r=2):                       # field: (time, lat, lon); longitude wraps around\n",
        "    ny, nx = field.shape[1:]; acc = 0.0\n",
        "    for di in range(-r, r + 1):\n",
        "        for dj in range(-r, r + 1):\n",
        "            acc = acc + field[ti, np.clip(li + di, 0, ny - 1), (lj + dj) % nx]\n",
        "    return acc / (2 * r + 1) ** 2\n",
        "\n",
        "def attach_env(d):\n",
        "    n = len(d); env = {c: np.full(n, np.nan) for c in ENV_COLS}\n",
        "    try:                                                      # ---- SST\n",
        "        ds = open_retry([SST_URL]); da = ds[\"sst\"].sel(time=slice(f\"{ENV_START}-01-01\", None)).transpose(\"time\", \"lat\", \"lon\").load(); ds.close()\n",
        "        t = d.time.dt.to_period(\"M\").dt.to_timestamp().values\n",
        "        ti = np.clip(np.searchsorted(da.time.values, t, side=\"right\") - 1, 0, da.sizes[\"time\"] - 1)\n",
        "        env[\"sst\"] = da.values[ti, nearest_index(da.lat.values, d.LAT.values), nearest_index(da.lon.values, d.LON.values % 360)]\n",
        "        print(\"SST done\")\n",
        "    except Exception as e: print(\"SST failed:\", str(e)[:150])\n",
        "    yrs = d.time.dt.year.values; ok_years = 0\n",
        "    for yr in sorted(set(yrs)):                               # ---- winds, one year at a time\n",
        "        rows = np.where(yrs == yr)[0]; t0 = time.time()\n",
        "        try:\n",
        "            f = {}\n",
        "            for var in (\"uwnd\", \"vwnd\"):\n",
        "                ds = open_retry(WIND_URLS, var=var, year=int(yr)); lat = ds[\"lat\"].values\n",
        "                sl = slice(50, -45) if lat[0] > lat[-1] else slice(-45, 50)\n",
        "                f[var] = ds[var].sel(level=[850, 500, 200], lat=sl).transpose(\"time\", \"level\", \"lat\", \"lon\").load(); ds.close()\n",
        "            u, v = f[\"uwnd\"], f[\"vwnd\"]\n",
        "            ti = np.clip(np.searchsorted(u.time.values, d.time.values[rows], side=\"right\") - 1, 0, u.sizes[\"time\"] - 1)\n",
        "            li, lj = nearest_index(u.lat.values, d.LAT.values[rows]), nearest_index(u.lon.values, d.LON.values[rows] % 360)\n",
        "            U = [box_mean(u.values[:, l], ti, li, lj) for l in range(3)]; V = [box_mean(v.values[:, l], ti, li, lj) for l in range(3)]\n",
        "            env[\"shear\"][rows] = np.hypot(U[2] - U[0], V[2] - V[0])\n",
        "            env[\"steer_u\"][rows] = np.mean(U, axis=0); env[\"steer_v\"][rows] = np.mean(V, axis=0)\n",
        "            ok_years += 1; print(f\"  {yr}: {len(rows)} obs ({time.time() - t0:.0f}s)\")\n",
        "        except Exception as e: print(f\"  {yr}: FAILED ({str(e)[:100]})\")\n",
        "    return pd.DataFrame(env, index=d.index), ok_years\n",
        "\n",
        "use_env = USE_ENV\n",
        "if use_env:\n",
        "    d2 = df[df.time.dt.year >= ENV_START].reset_index(drop=True)\n",
        "    if os.path.exists(ENV_CACHE):\n",
        "        cache = pd.read_csv(ENV_CACHE, parse_dates=[\"time\"]); d2 = d2.merge(cache, on=[\"SID\", \"time\"], how=\"left\"); print(\"Loaded cached environment fields\")\n",
        "    else:\n",
        "        t0 = time.time(); e_df, n_ok = attach_env(d2); d2[ENV_COLS] = e_df.values\n",
        "        print(f\"Environment download took {(time.time() - t0) / 60:.1f} min, {n_ok} wind years OK\")\n",
        "        d2[[\"SID\", \"time\"] + ENV_COLS].to_csv(ENV_CACHE, index=False)\n",
        "    cov = d2[ENV_COLS].notna().mean(); print(\"coverage:\", cov.round(2).to_dict())\n",
        "    if cov[\"shear\"] > 0.85 and cov[\"sst\"] > 0.5:       # SST is legitimately missing over land\n",
        "        df = d2\n",
        "    else:\n",
        "        print(\"!! Environment coverage too low - continuing WITHOUT environmental fields.\"); use_env = False\n",
        "if not use_env:\n",
        "    for c in ENV_COLS: df[c] = np.nan\n",
        "print(\"USE_ENV =\", use_env, \"|\", df.SID.nunique(), \"storms,\", len(df), \"observations\")"
      ]
