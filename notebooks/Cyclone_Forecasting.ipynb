            "Landfall approach: {'n_events': 619, 'n': 5667, 'auc': 0.748, 'precision': 0.689, 'recall': 0.333, 'f1': 0.449, 'threshold': 0.5}\n",
            "(Persistence predicts neither event by construction: constant wind and distance to land.)\n"
          ]
        }
      ],
      "source": [
        "def event_metrics(y_true, prob, thr):\n",
        "    out = dict(n_events=int(y_true.sum()), n=int(len(y_true)))\n",
        "    out[\"auc\"] = float(roc_auc_score(y_true, prob)) if 0 < y_true.sum() < len(y_true) else float(\"nan\")\n",
        "    p, r, f, _ = precision_recall_fscore_support(y_true, prob >= thr, average=\"binary\", zero_division=0)\n",
        "    return {**out, \"precision\": float(p), \"recall\": float(r), \"f1\": float(f), \"threshold\": thr}\n",
        "\n",
        "S = STEPS\n",
        "ri_true = Yte[:, 3 * S - 1] >= 30\n",
        "ri_prob = (Rte_m[:, :, 3 * S - 1] + Pp_te[:, 3 * S - 1] >= 30).mean(0)\n",
        "ri = event_metrics(ri_true, ri_prob, 0.4); print(\"Rapid intensification:\", {k: round(v, 3) for k, v in ri.items()})\n",
        "\n",
        "cond = mte.d2l0.values > 100\n",
        "lf_true = (mte.d2l0.values + Yte[:, 4 * S - 1] <= 100)[cond]\n",
        "lf_prob = np.clip(mte.d2l0.values[None, :] + Pp_te[:, 4 * S - 1][None] + Rte_m[:, :, 4 * S - 1], 0, None)[:, cond]\n",
        "lf_prob = (lf_prob <= 100).mean(0)\n",
        "lf = event_metrics(lf_true, lf_prob, 0.5); print(\"Landfall approach:\", {k: round(v, 3) for k, v in lf.items()})\n",
        "print(\"(Persistence predicts neither event by construction: constant wind and distance to land.)\")\n",
        "events = dict(ri=ri, landfall=lf)"
      ]
    },
