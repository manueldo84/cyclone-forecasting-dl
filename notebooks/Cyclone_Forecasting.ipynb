        "def build_model(arch, nf):\n",
        "    i = keras.Input((H, nf))\n",
        "    if arch == \"MLP\":\n",
        "        x = layers.Flatten()(i); x = layers.Dense(256, activation=\"relu\")(x); x = layers.Dropout(0.2)(x); x = layers.Dense(128, activation=\"relu\")(x)\n",
        "    else:\n",
        "        R = layers.LSTM if arch == \"LSTM\" else layers.GRU\n",
        "        x = R(96, return_sequences=True)(i); x = R(48)(x); x = layers.Dense(64, activation=\"relu\")(x)\n",
        "    return keras.Model(i, layers.Dense(4 * STEPS)(x), name=arch.lower())\n",
        "\n",
        "def train(arch, fi, seed=0):\n",
        "    keras.utils.set_random_seed(seed)\n",
        "    m = build_model(arch, len(fi)); m.compile(optimizer=keras.optimizers.Adam(1e-3), loss=\"mse\")\n",
        "    cb = [keras.callbacks.EarlyStopping(patience=6, restore_best_weights=True),\n",
        "          keras.callbacks.ReduceLROnPlateau(factor=0.5, patience=3, min_lr=1e-6)]\n",
        "    t0 = time.time()\n",
        "    h = m.fit(Xtr_s[:, :, fi], Rtr_s, validation_data=(Xva_s[:, :, fi], Rva_s), epochs=EPOCHS, batch_size=256, callbacks=cb, verbose=0).history\n",
        "    print(f\"  {arch} seed {seed}: {len(h['loss'])} epochs, best val loss {min(h['val_loss']):.4f} ({time.time() - t0:.0f}s)\")\n",
        "    return m, h\n",
        "\n",
        "def resid(m, Xs, fi): return m.predict(Xs[:, :, fi], batch_size=2048, verbose=0) * r_std + r_mean\n",
        "\n",
        "models, hists, val_err = {}, {}, {}\n",
        "for arch in [\"MLP\", \"LSTM\", \"GRU\"]:\n",
        "    models[arch], hists[arch] = train(arch, FI)\n",
        "    val_err[arch] = mean_track_24(Pp_va + resid(models[arch], Xva_s, FI), Yva, mva)\n",
        "    preds[arch] = Pp_te + resid(models[arch], Xte_s, FI); results[arch] = eval_preds(preds[arch], Yte, mte)\n",
        "BEST = min(val_err, key=val_err.get)\n",
        "print(\"Validation 24 h track error (km):\", {k: round(v, 1) for k, v in val_err.items()}, \"-> chosen architecture:\", BEST)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7, 4))\n",
        "for n, h in hists.items(): ax.plot(h[\"val_loss\"], label=f\"{n} val\"); ax.plot(h[\"loss\"], \":\", label=f\"{n} train\")\n",
        "ax.set_xlabel(\"epoch\"); ax.set_ylabel(\"loss (standardised MSE)\"); ax.legend(fontsize=7); plt.tight_layout()\n",
        "plt.savefig(OUT / \"fig_curves.png\", dpi=150); plt.show()"
      ]
    },
