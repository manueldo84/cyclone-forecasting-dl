      "source": [
        "Pb = preds[ENS]; lat0, lon0 = mte.lat0.values, mte.lon0.values\n",
        "d_m = haversine_km(lat0 + Pb[:, S - 1], lon0 + Pb[:, 2 * S - 1], lat0 + Yte[:, S - 1], lon0 + Yte[:, 2 * S - 1])\n",
        "d_p = haversine_km(lat0 + Pp_te[:, S - 1], lon0 + Pp_te[:, 2 * S - 1], lat0 + Yte[:, S - 1], lon0 + Yte[:, 2 * S - 1])\n",
        "by = pd.DataFrame({\"basin\": mte.basin, \"model_km\": d_m, \"persistence_km\": d_p}).groupby(\"basin\").agg(\n",
        "    windows=(\"model_km\", \"size\"), model_km=(\"model_km\", \"mean\"), persistence_km=(\"persistence_km\", \"mean\")).round(1)\n",
        "display(by); by.to_csv(OUT / \"error_by_basin.csv\")\n",
        "bins = pd.cut(mte.wind0, [0, 34, 64, 96, 300], labels=[\"<34 kt\", \"34-63 kt\", \"64-95 kt\", \">=96 kt\"])\n",
        "display(pd.DataFrame({\"bin\": bins, \"model_km\": d_m, \"persistence_km\": d_p}).groupby(\"bin\", observed=True).mean().round(1))"
