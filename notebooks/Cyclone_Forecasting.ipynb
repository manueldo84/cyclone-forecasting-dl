        "## 5. Supervised windows and storm-level split\n",
        "- Each sample: 8 consecutive 6-hourly observations (19 features each) -> **16 targets**: change in latitude, longitude, wind and distance-to-land at +6..+24 h relative to the last observation.\n",
        "- Windows come only from continuous 6-hourly segments; longitude is unwrapped at the dateline.\n",
        "- **Split by storm** (70/15/15), never by time step. Case-study storms are forced into the test set.\n",
        "- The network learns the **residual over persistence** (what persistence gets wrong), so it can only improve on a strong baseline, not rediscover it."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "0c5f5296",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0c5f5296",
        "outputId": "be2e1315-df45-4d73-c9be-32b4b299f636"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "windows: (45120, 8, 19) targets: (45120, 16)\n",
            "OCKHI 2017: ['2017333N06082']\n",
            "NIVAR 2020: ['2020327N08086']\n",
            "AMPHAN 2020: ['2020136N10088']\n",
            "TAUKTAE 2021: ['2021133N10071']\n",
            "{'train': 31464, 'val': 7034, 'test': 6622} windows\n",
            "Features used: ['lat', 'sin_lon', 'cos_lon', 'wind_kt', 'log_dist2land', 'dlat', 'dlon', 'dwind', 'sin_month', 'cos_month', 'speed_kmh', 'sin_heading', 'cos_heading', 'pres_hpa', 'has_pres', 'sst_c', 'shear_ms', 'steer_u', 'steer_v']\n"
          ]
        }
      ],
      "source": [
        "def build_windows(d):\n",
        "    Xs, Ys, meta = [], [], []\n",
        "    for sid, g in d.groupby(\"SID\", sort=False):\n",
        "        t = g.time.values\n",
        "        seg = np.cumsum(np.r_[False, np.diff(t) != np.timedelta64(6, \"h\")])\n",
        "        for s_ in np.unique(seg):\n",
        "            m = seg == s_\n",
        "            if m.sum() < H + STEPS + 1: continue\n",
        "            lat, lon, wind = g.LAT.values[m], g.LON.values[m], g.wind.values[m].astype(float)\n",
        "            d2l, month = g.DIST2LAND.values[m], g.time.dt.month.values[m]\n",
        "            F = storm_features(lat, lon, wind, d2l, month, g.pres.values[m], g.sst.values[m], g.shear.values[m],\n",
        "                               g.steer_u.values[m], g.steer_v.values[m])\n",
        "            lon_u = unwrap_lon(lon); basin = g.BASIN.iloc[0]\n",
        "            for e in range(H, len(lat) - STEPS):\n",
        "                Xs.append(F[e - H + 1:e + 1])\n",
        "                Ys.append(np.concatenate([lat[e + 1:e + STEPS + 1] - lat[e], lon_u[e + 1:e + STEPS + 1] - lon_u[e],\n",
        "                                          wind[e + 1:e + STEPS + 1] - wind[e], d2l[e + 1:e + STEPS + 1] - d2l[e]]))\n",
        "                meta.append((sid, basin, lat[e], lon[e], wind[e], d2l[e]))\n",
        "    return np.array(Xs, \"float32\"), np.array(Ys, \"float32\"), pd.DataFrame(meta, columns=[\"sid\", \"basin\", \"lat0\", \"lon0\", \"wind0\", \"d2l0\"])\n",
        "\n",
        "X, Y, meta = build_windows(df)\n",
        "print(\"windows:\", X.shape, \"targets:\", Y.shape)\n",
        "\n",
        "forced = []\n",
        "for nm, yr in CASES:\n",
        "    found = df[(df.NAME == nm) & (df.SEASON == yr) & (df.BASIN == \"NI\")].SID.unique().tolist()\n",
        "    print(f\"{nm} {yr}:\", found or \"NOT FOUND (not in the selected years/data)\"); forced += found\n",
        "rest = np.array(sorted(set(meta.sid) - set(forced)))\n",
        "tr_s, tmp_s = train_test_split(rest, test_size=0.30, random_state=SEED)\n",
        "va_s, te_s = train_test_split(tmp_s, test_size=0.50, random_state=SEED)\n",
        "te_s = np.concatenate([te_s, np.array(forced, dtype=te_s.dtype)]) if len(forced) else te_s\n",
        "idx = {k: np.where(meta.sid.isin(v))[0] for k, v in {\"train\": tr_s, \"val\": va_s, \"test\": te_s}.items()}\n",
        "print({k: len(v) for k, v in idx.items()}, \"windows\")\n",
        "Xtr, Ytr, Xva, Yva, Xte, Yte = X[idx[\"train\"]], Y[idx[\"train\"]], X[idx[\"val\"]], Y[idx[\"val\"]], X[idx[\"test\"]], Y[idx[\"test\"]]\n",
        "mva, mte = meta.iloc[idx[\"val\"]].reset_index(drop=True), meta.iloc[idx[\"test\"]].reset_index(drop=True)\n",
        "\n",
        "NF = X.shape[2]\n",
        "x_mean, x_std = Xtr.reshape(-1, NF).mean(0), Xtr.reshape(-1, NF).std(0) + 1e-6\n",
        "nx = lambda a: (a - x_mean) / x_std\n",
        "Xtr_s, Xva_s, Xte_s = nx(Xtr), nx(Xva), nx(Xte)\n",
        "Pp_tr, Pp_va, Pp_te = (persistence_delta(a[:, -1, :]) for a in (Xtr, Xva, Xte))     # persistence from RAW features\n",
        "Rtr, Rva = Ytr - Pp_tr, Yva - Pp_va\n",
        "r_mean, r_std = Rtr.mean(0), Rtr.std(0) + 1e-6\n",
        "Rtr_s, Rva_s = (Rtr - r_mean) / r_std, (Rva - r_mean) / r_std\n",
        "FI = GROUPS[\"base\"] + GROUPS[\"motion_pressure\"] + (GROUPS[\"environment\"] if use_env else [])\n",
        "print(\"Features used:\", [FEATS[i] for i in FI])"
      ]
    },
