      "source": [
        "## 9. Calibrated uncertainty (the circles in the app)\n",
        "Radius at each lead = the 67th percentile of track errors on the **validation** storms. On the **test** set about 67% of true positions should fall inside the circles."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "id": "306e5673",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "306e5673",
        "outputId": "d79b133a-27c9-426d-c441-7fd39062c7ac"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "67% radius (km): [ 31.  68. 113. 164.] | 90% radius: [ 54. 115. 189. 273.] | test coverage of 67% circle: [0.65 0.64 0.65 0.65]\n"
          ]
        }
      ],
      "source": [
        "def track_errs(R_mean, Pp, Yt, m):\n",
        "    lat0, lon0 = m.lat0.values, m.lon0.values; P = Pp + R_mean\n",
        "    return np.stack([haversine_km(lat0 + P[:, k], lon0 + P[:, STEPS + k], lat0 + Yt[:, k], lon0 + Yt[:, STEPS + k]) for k in range(STEPS)], 1)\n",
        "ev, et = track_errs(Rva_m.mean(0), Pp_va, Yva, mva), track_errs(Rte_m.mean(0), Pp_te, Yte, mte)\n",
        "cone67, cone90 = np.percentile(ev, 67, axis=0), np.percentile(ev, 90, axis=0)\n",
        "coverage = (et <= cone67).mean(0)\n",
        "print(\"67% radius (km):\", cone67.round(0), \"| 90% radius:\", cone90.round(0), \"| test coverage of 67% circle:\", coverage.round(2))"
      ]
    },
